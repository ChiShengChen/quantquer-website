{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quantquer public benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "project", "experimentType", "evidenceType", "metrics", "rawArtifactPath", "reproducibilityCommand", "limitations", "timestamp", "timestampMeaning"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "project": { "type": "string" },
    "experimentType": { "type": "string" },
    "evidenceType": { "enum": ["measured", "simulated", "replayed"] },
    "gitCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "hardware": { "type": "object", "additionalProperties": { "type": "string" } },
    "software": { "type": "object", "additionalProperties": { "type": "string" } },
    "dataset": { "type": "string" },
    "config": { "type": "object" },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value", "unit"],
        "properties": {
          "id": { "type": "string" },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "group": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "rawArtifactPath": { "type": "string", "pattern": "^/" },
    "reproducibilityCommand": { "type": "string" },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "timestamp": { "type": "string", "format": "date" },
    "timestampMeaning": { "enum": ["recorded run date", "fixture report date"] }
  }
}
